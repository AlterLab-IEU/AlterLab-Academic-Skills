{
  "workflow": "grant-mock-panel",
  "synthetic": true,
  "_comment": "What a live run of grant-mock-panel on the fictional R01 resubmission (../../r01_resubmission_a1.md, also used by evals.json) must produce. The script always runs 4 reviewers. 'findings' are the answer key from evals.json and never change pass/fail: the claimed Aim 2 power analysis is missing (C.2.4 only says 'adequate'); individual randomization with group delivery ignores clustering; the recruitment critique is answered in C.1.3.",
  "args_file": "args.json",
  "report": "grant-panel.md",
  "mock_agent_count": 10,
  "status": {"allowed": ["complete", "partial", "blocked"], "target": "complete"},
  "outputs": [
    {"path": "grant-panel.md", "type": "md", "role": "report"}
  ],
  "payload": {
    "required_keys": ["status", "status_reasons", "report", "coverage"],
    "required_keys_when_delivered": [
      "scale", "overall_mean", "overall_scores", "criteria", "reviewers.requested", "reviewers.completed", "reviewers.missing",
      "weaknesses.raised", "weaknesses.standing", "weaknesses.unverified", "weaknesses.withdrawn",
      "standing_weaknesses", "withdrawn_weaknesses", "unverified_weaknesses", "summary"
    ]
  },
  "coverage": {"required_stages": ["reviewers", "scores", "overall_scores", "weakness_checks", "report"]},
  "findings": [
    {"name": "NIH 1-9 scale", "path": "scale", "op": "contains", "value": "1–9"},
    {"name": "four reviewers reported", "path": "reviewers.completed", "op": "==", "value": 4},
    {"name": "missing Aim 2 power analysis found", "file": "grant-panel.md", "pattern": "power"},
    {"name": "ignored clustering found", "file": "grant-panel.md", "pattern": "cluster"},
    {"name": "simulation, not a prediction", "file": "grant-panel.md", "pattern": "simulat|not a (funding )?prediction"}
  ]
}
