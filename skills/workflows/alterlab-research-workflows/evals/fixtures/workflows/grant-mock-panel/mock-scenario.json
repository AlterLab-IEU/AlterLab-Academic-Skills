{
  "_comment": "MOCK RUNTIME SCENARIO, not live output. Pins agent results in scripts/workflow_dryrun.mjs to the shape the fixture should produce (NIH 1-9 scale; weaknesses from the evals.json answer key for r01_resubmission_a1.md), for mock-derived agent counts and the checker tests. Says nothing about live model behaviour.",
  "rules": [
    {"match": "^funder criteria", "return": {"scale_min": 1, "scale_max": 9, "lower_is_better": true, "source": "NIH simplified peer review framework (mock)", "criteria": [
      {"key": "importance", "title": "Importance of the Research", "guidance": "significance and innovation"},
      {"key": "rigor", "title": "Rigor and Feasibility", "guidance": "approach, rigor, feasibility"},
      {"key": "expertise", "title": "Expertise and Resources", "guidance": "investigators and environment"}
    ]}},
    {"match": "^primary reviewer", "return": {"scores": [{"key": "importance", "score": 2, "rationale": "high-burden outcome"}, {"key": "rigor", "score": 4, "rationale": "clustering ignored"}, {"key": "expertise", "score": 2, "rationale": "experienced team"}], "overall": 3, "strengths": ["pragmatic design"], "weaknesses": [
      {"id": "W1", "severity": "major", "issue": "Randomized individually but delivered in walking groups; models ignore clustering by group.", "where": "C.3 Analysis"}]}},
    {"match": "^secondary reviewer", "return": {"scores": [{"key": "importance", "score": 2, "rationale": "important"}, {"key": "rigor", "score": 5, "rationale": "no Aim 2 power analysis"}, {"key": "expertise", "score": 3, "rationale": "2% economist effort"}], "overall": 4, "strengths": ["recruitment partners"], "weaknesses": [
      {"id": "W1", "severity": "major", "issue": "The resubmission says an Aim 2 power analysis was added, but C.2.4 only calls 180 participants adequate.", "where": "C.2.4 Sample size"}]}},
    {"match": "^tertiary reviewer", "return": {"scores": [{"key": "importance", "score": 3, "rationale": "clear"}, {"key": "rigor", "score": 4, "rationale": "fidelity plan"}, {"key": "expertise", "score": 2, "rationale": "strong"}], "overall": 3, "strengths": ["clear aims"], "weaknesses": [
      {"id": "W1", "severity": "minor", "issue": "Cost-effectiveness horizon not justified.", "where": "Aim 3"}]}},
    {"match": "^skeptic reviewer", "return": {"scores": [{"key": "importance", "score": 3, "rationale": "known benefit"}, {"key": "rigor", "score": 6, "rationale": "clustering"}, {"key": "expertise", "score": 3, "rationale": "thin economics"}], "overall": 5, "strengths": ["blinded assessors"], "weaknesses": [
      {"id": "W1", "severity": "major", "issue": "Recruitment of low-income older adults may fall short.", "where": "C.1 Recruitment"}]}},
    {"match": "^check primary", "return": {"stands": true, "reason": "C.3 analyses at the individual level", "quote": "analysed at the individual level"}},
    {"match": "^check secondary", "return": {"stands": true, "reason": "no power calculation in C.2.4", "quote": "which is adequate for this analysis"}},
    {"match": "^check skeptic", "return": {"stands": false, "reason": "C.1.3 gives an alternative recruitment strategy", "quote": "Alternative recruitment strategy"}},
    {"match": "^confirm report on disk", "return": {"exists": true, "bytes": 4096, "first_heading": "# Mock study section summary statement", "states_status": "COMPLETE"}}
  ]
}
